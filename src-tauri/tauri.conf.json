{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dialed",
  "version": "0.1.2",
  "identifier": "com.nowakdev.dialed",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dialed",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "nowaaak",
    "shortDescription": "Windows-Tweaking-Tool mit Zustandserkennung",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2QzM2NjQzQUMxMUREN0IKUldSNzNSR3NRMmJEaHZTbGtpSzB2V09DZHA3cE95cHBSM2lIczMyM1pxRTZ1K0NPU1dtUjNGTWEK",
      "endpoints": [
        "https://github.com/nowaaak/dialed/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
